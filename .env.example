# Copy to .env and fill in real values. .env is git-ignored — never commit it.
#
# This file documents DEVELOPMENT. The production profile
# (config/settings_prod.py) requires a few more variables and refuses to start
# without them — the full list, with what each one is for, is in docs/deploy.md.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generate-a-real-secret-key

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL burned into every printed QR label. Change it BEFORE printing
# labels for a customer: a sticker on a machine cannot be edited afterwards.
SITE_URL=http://localhost:8000

# Default matches docker-compose.yml's db service (docker compose up -d db).
# No Docker on your machine? Use a free Postgres from neon.tech or supabase.com instead —
# SQLite is not an option, not even for tests.
DATABASE_URL=postgresql://cmms:cmms@localhost:5432/cmms

# How much the application says out loud. INFO is the default and shows the
# webhook warnings; DEBUG adds every SQL query and is only useful when hunting
# something specific.
LOG_LEVEL=INFO

# Email (brief 07). Leave EMAIL_BACKEND unset in development: the default prints
# the message to the console instead of sending it, attachment and all.
# Gmail needs an app password, not the account password.
# Check it end to end with: python manage.py send_test_email --to tucorreo@dominio.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Vectron Management <no-reply@vectron.local>

# n8n webhook (brief 08). Leave N8N_WEBHOOK_URL empty and nothing is emitted —
# the app works exactly the same, which is the point (see docs/webhooks.md).
# The token is a secret: it goes in the X-Vectron-Token header, never in a
# payload, never in a log, and never in this repo.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_TIMEOUT=3.0


# --------------------------------------------------------------------------
# Production only (config/settings_prod.py) — NOT used in development
# --------------------------------------------------------------------------
#
# Set these on the platform (Railway variables, VPS environment file), never in
# a committed file. Listed here so nobody has to read the settings module to
# find out what a deployment needs. Full explanations: docs/deploy.md.
#
# DJANGO_SETTINGS_MODULE=config.settings_prod   # the Dockerfile already sets it
# ALLOWED_HOSTS=cmms.midominio.com              # required, comma-separated
# CSRF_TRUSTED_ORIGINS=https://cmms.midominio.com  # required, with scheme
# SITE_URL=https://cmms.midominio.com           # required, must be https
# TRUST_PROXY_SSL_HEADER=True                   # on Railway/nginx; see docs
# SECURE_HSTS_SECONDS=3600                      # raise gradually to 31536000
# WEB_CONCURRENCY=3                             # gunicorn workers
# GUNICORN_TIMEOUT=120                          # seconds; PDFs are slow
# BACKUP_RETENTION_DAYS=14                      # scripts/backup.sh
# MEDIA_ROOT_PATH=/app/media                    # so backups include uploads
